# Godot
.godot/
*.translation

# .NET build output (but keep bundled video tools + Discord Social SDK in bin/)
bin/*
!bin/ffmpeg
!bin/yt-dlp
!bin/ffmpeg.exe
!bin/yt-dlp.exe
!bin/libdiscord_partner_sdk.so
!bin/discord_partner_sdk.dll
!bin/libdiscord_partner_sdk.dylib
obj/
*.user

# Export artifacts
build/

# Secrets
.env
.env.*
!.env.example

# Bundled avatar binaries are large and often carry third-party model licenses; generate them
# locally with tools/ska/vrm2ska.py rather than committing them. See Assets/Avatars/README.md.
Assets/Avatars/*.ska

# Launcher build output (bin/* above is anchored to the repo root)
Launcher/bin/

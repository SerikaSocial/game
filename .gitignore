# Godot
.godot/
*.translation

# .NET build output (but keep bundled video tools in bin/)
bin/*
!bin/ffmpeg
!bin/yt-dlp
!bin/ffmpeg.exe
!bin/yt-dlp.exe
obj/
*.user

# Export artifacts
build/

# Secrets
.env
.env.*

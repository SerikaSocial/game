<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone test project for the wire codec. It compiles the codec sources directly
    (they are pure C#, no Godot dependency) so `dotnet test` can run them without the engine.
    The Godot game project compiles the same files. This is what proves the C# codec agrees
    byte-for-byte with the Rust relay.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\CodecException.cs" />
    <Compile Include="..\PoseFrame.cs" />
    <Compile Include="..\VoiceFrame.cs" />
    <!-- ObjectSync/PhysGrab framing. Not part of the golden corpus (the relay treats these bodies
         as opaque), but the two transports disagree on PhysGrab's layout by design, so the
         difference needs a test to keep it from rotting. -->
    <Compile Include="..\..\ObjectFrames.cs" />
    <!-- The canonical bone order. The relay only ever sees "N quaternions", so which bone each
         wire slot means is decided entirely here, and agreed between a sender and a receiver that
         are both this client. That makes it as load-bearing as the byte layout, so it gets the
         same treatment: a frozen test in the same suite. Pure C#, no Godot dependency. -->
    <Compile Include="..\..\..\Avatar\HumanoidBones.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>

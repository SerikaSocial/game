[internationalization]

locale/translations_pot_files=PackedStringArray("res://Dialogue/tutorial_vr.dialogue", "res://Dialogue/tutorial_desktop.dialogue", "res://Dialogue/tutorial_mobile.dialogue")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

; Quest/Android must use the `mobile` renderer. This was set to "forward_plus", which is a
; desktop-only renderer — Godot hard-fails the Android export on it, and it is why the Quest
; build could never ship an XR-capable APK.
; Godot 4.7.1 cannot do OpenXR + Vulkan on Android: PR #114922 introduced a global Vulkan
; context that breaks the XR VulkanHooks path (`xrCreateVulkanDeviceKHR` ->
; XR_ERROR_VALIDATION_FAILURE). The fix (PR #116226) landed on master only and is NOT in
; 4.7.1. `gl_compatibility` bypasses Vulkan entirely and is the supported workaround until
; we move to a Godot build containing that fix.
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[xr]

; No `openxr/default_action_map` here on purpose. That setting loads an *OpenXRActionMap
; resource*; it used to point at `xr_actions.json`, which can never deserialise into one, so
; OpenXR fell back to `create_default_action_sets()` every run. With the setting absent that
; fallback is now the deliberate choice: Godot's built-in map covers Touch, Index and the
; simple controller, and `VrPlayer` reads those built-in action names directly.
; Without this the OpenXR module never builds a loader/instance, so
; `XRServer.FindInterface("OpenXR").Initialize()` returns false on every platform.
openxr/enabled=true
openxr/form_factor="head_mounted"
openxr/reference_space="local"
openxr/submit_depth_buffer=true
openxr/extensions/hand_tracking=true

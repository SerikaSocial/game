[internationalization]

locale/translations_pot_files=PackedStringArray("res://Dialogue/tutorial_vr.dialogue", "res://Dialogue/tutorial_desktop.dialogue", "res://Dialogue/tutorial_mobile.dialogue")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/use_debanding=true

[xr]

openxr/enabled=true
; Both of these are ENUMS, not strings. They were written here as strings, which Godot coerces
; through String→int — i.e. to 0. form_factor 0 is Head Mounted, so that one was right by
; accident; reference_space 0 is LOCAL, a SEATED space whose origin is wherever the headset
; happened to be at startup, at HEADSET height rather than floor height. That broke VR outright:
; VrPlayer.TryAutoCalibrate reads the camera's local Y as the floor-to-headset distance and
; rejects anything outside 0.3–2.5 m, so it never calibrated, and ApplyHeightOffset then parked
; the play space from a 1.65 m constant with the viewpoint down near the floor.
; 2 = Local Floor: floor-height origin that still honours recentering (VrPlayer.Recenter), which
; Godot emulates when XR_EXT_local_floor is unavailable.
openxr/form_factor=0
openxr/reference_space=2
openxr/submit_depth_buffer=true
openxr/extensions/hand_tracking=true
; No modal when OpenXR fails to start.
;
; Godot's default is to pop a blocking `zenity` alert when the runtime cannot be reached, which on
; a machine with no headset is *every* launch. `--headless` does not suppress it, so a diagnostic
; run on a dev box sits at 0% CPU with no output, looking exactly like a test that never started —
; the hang this repo's docs work around by telling every agent to unset DISPLAY first. It is also
; wrong in production: a desktop player with no headset should get the desktop client, not a dialog
; about OpenXR. `VrPlayer.TryInitVr` already logs the failure and falls back, which is all the
; alert was ever for.
openxr/startup_alert=false

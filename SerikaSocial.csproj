<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <!--
      Desktop (Linux/Windows/macOS) builds target net8.0 — the documented Godot 4.7 mono
      convention. The Android/Quest export template only accepts net9.0 assemblies, so when
      Godot builds for Android it sets GodotTargetPlatform=android and we retarget to net9.0
      for that build only. Desktop output is unchanged.
    -->
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <!--
      iOS stays on net8.0 (the desktop default) but must be AOT-compiled: Apple forbids JIT, so
      a normal Godot mono build cannot run there at all. `GodotTargetPlatform=ios` is what Godot
      sets during an iOS export, and these two properties are what turn the build into an
      AOT/static one the export template can link.

      NOT VERIFIED ON DEVICE — no iOS export has been run. Treat this block as the starting
      point for the first real build, not as a working configuration.
    -->
    <PublishAot Condition=" '$(GodotTargetPlatform)' == 'ios' ">true</PublishAot>
    <RuntimeIdentifier Condition=" '$(GodotTargetPlatform)' == 'ios' ">ios-arm64</RuntimeIdentifier>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>SerikaSocial</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- The Discord Social SDK P/Invoke layer (Discord/DiscordNative.cs) pins Discord_String
         buffers on the stack when feeding the C API's pointer-typed optional setters. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    No debug symbols in a shipping build.

    The export was packaging `SerikaSocial.pdb` into every platform: the Quest APK
    (assets/.godot/mono/publish/arm64/), both macOS slices, and the Linux/Windows data payloads.
    A portable PDB carries local variable names, exact line numbers and source file names — but
    the reason that actually matters here is SourceLink: the PDB embedded a JSON map from the
    absolute build path to raw.githubusercontent.com URLs pinned to the exact commit SHAs of the
    private `SerikaSocial/game` and `SerikaSocial/proto` repositories. Shipping that hands every
    player the build machine's directory layout and the precise commits the binary was cut from,
    and points a debugger straight at the original files should those repos ever be readable.

    Note what this does NOT buy: a .NET assembly already contains complete metadata — every type,
    method, field and property name, plus the IL — so ILSpy reconstructs near-source C# from the
    DLL alone, with or without a PDB. Stripping symbols is hygiene and disclosure control, not
    copy protection. Anything that must not be readable belongs on the server, which is where this
    project already keeps auth and moderation.

    Only ExportRelease is stripped, so `dotnet build` and ExportDebug keep full symbols and local
    debugging and stack traces are unaffected.
  -->
  <PropertyGroup Condition=" '$(Configuration)' == 'ExportRelease' ">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <IncludeSymbolsInSingleFile>false</IncludeSymbolsInSingleFile>
  </PropertyGroup>

  <!--
    The codec test project (Net/Codec/Tests) and the SerikaScript sandbox test project
    (Script/Tests) reference xUnit and must NOT be part of the Godot build. The sources they
    exercise ARE compiled here — they're the same files, so what ships is exactly what is
    verified.
  -->
  <ItemGroup>
    <Compile Remove="Net/Codec/Tests/**/*.cs" />
    <Compile Remove="Script/Tests/**/*.cs" />
    <Compile Remove="proto/**/*.cs" />
    <Compile Remove="Launcher/**/*.cs" />
  </ItemGroup>
</Project>

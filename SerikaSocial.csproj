<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <!--
      Desktop (Linux/Windows/macOS) builds target net8.0 — the documented Godot 4.7 mono
      convention. The Android/Quest export template only accepts net9.0 assemblies, so when
      Godot builds for Android it sets GodotTargetPlatform=android and we retarget to net9.0
      for that build only. Desktop output is unchanged.
    -->
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>SerikaSocial</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!--
    The codec test project (Net/Codec/Tests) references xUnit and must NOT be part of the
    Godot build. The codec sources themselves ARE compiled here — they're the same files the
    tests exercise, so what ships is exactly what is verified.
  -->
  <ItemGroup>
    <Compile Remove="Net/Codec/Tests/**/*.cs" />
    <Compile Remove="proto/**/*.cs" />
    <Compile Remove="Launcher/**/*.cs" />
  </ItemGroup>
</Project>
